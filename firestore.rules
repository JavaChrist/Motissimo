rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrateur JavaChrist : claim `admin` posé par script, jamais par le client.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Grilles en ligne : lues par tous les joueurs, écrites par l'administration seule.
    // Les grilles du jeu sont dans l'application : aucun joueur n'a à en écrire.
    match /puzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progression d'un joueur. Pendant et juste après une suppression de compte, la marque
    // deleted_accounts/{uid} bloque l'ancien jeton (valable une heure au plus) : ni lecture ni écriture.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deleted_accounts/$(uid));
    }

    // Marques de suppression : posées et effacées par scripts/delete-account.mjs, jamais par un client.
    match /deleted_accounts/{uid} {
      allow read, write: if false;
    }

    // Référentiel des applications et campagnes (brouillons compris) : administration seule.
    match /apps/{id} {
      allow read, write: if isAdmin();
    }

    match /campaigns/{id} {
      allow read, write: if isAdmin();
    }

    // Bibliothèque de clips (fiches) : administration seule.
    match /clips/{id} {
      allow read, write: if isAdmin();
    }

    // Projection publiée par l'API serveur (SDK Admin) : lecture seule pour les jeux.
    match /public_catalogs/{sourceAppId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
